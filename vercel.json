{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/tab-thursday", "destination": "/tab-thursday/index.html" },
    { "source": "/tab-thursday/", "destination": "/tab-thursday/index.html" }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "public/stickers/catalog.json",
      "maxDuration": 30
    }
  }
}
